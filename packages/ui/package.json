{
  "name": "@cloudsforge/ui",
  "version": "1.0.0",
  "description": "The CloudsForge design system: tokens, chrome, brand marks and chart primitives.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "src/index.tsx",
  "types": "src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./charts": "./src/charts.tsx",
    "./surfaces": "./src/surfaces.ts",
    "./tokens.css": "./src/tokens.css",
    "./ui.css": "./src/ui.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./charts": { "types": "./dist/charts.d.ts", "default": "./dist/charts.js" },
      "./surfaces": { "types": "./dist/surfaces.d.ts", "default": "./dist/surfaces.js" },
      "./tokens.css": "./dist/tokens.css",
      "./ui.css": "./dist/ui.css",
      "./package.json": "./package.json"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "build": "tsc -p tsconfig.build.json && cp src/tokens.css src/ui.css dist/",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
