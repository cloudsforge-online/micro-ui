{
  "compilerOptions": {
    "target": "ES2023",
    // DOM is in the library set because this package IS the browser chrome: it reads
    // window.location, rewrites history and renders SVG. Every DOM read is still guarded by
    // `typeof window !== 'undefined'` so the same build renders on a server.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // Sources import each other with the '.ts'/'.tsx' extension so `node --import tsx` and `tsc`
    // agree on one spelling; the emitter rewrites them to '.js' in dist. Without the rewrite,
    // published packages would carry imports that resolve only under a TypeScript loader.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true
  }
}
